# Base URL of the backend API (see ../backend)
VITE_API_BASE_URL=http://localhost:4000/api

# Firebase Web App config for admin new-order push notifications (Priority 7).
# Register a Web App in the SAME Firebase project already used for the mobile
# app's FCM (Firebase console > Project settings > General > Your apps > Add
# app > Web), then generate a Web Push certificate (Cloud Messaging tab) for
# VITE_FIREBASE_VAPID_KEY. These values are public/client-safe by Firebase's
# own design (restricted by Firebase Security Rules, not by secrecy) — still,
# leave them unset to run the dashboard with admin push disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
