# Base URL of the backend API (see ../backend).
# Android emulator: use 10.0.2.2 to reach your host machine's localhost.
# iOS simulator / physical device: use your machine's LAN IP instead of localhost.
API_BASE_URL=http://10.0.2.2:4000/api

# Client-side Razorpay key (safe to expose; the secret stays server-side in backend/.env)
RAZORPAY_KEY_ID=
