# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/b2b_store?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Cloud Messaging (push notifications)
# Either paste the whole service-account JSON (raw or base64) into FIREBASE_SERVICE_ACCOUNT...
FIREBASE_SERVICE_ACCOUNT=
# ...or set the three fields individually. Keep the \n escapes in the private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Leave all of the above empty to run the API with push disabled.

# Timezone/currency used to word notifications ("Arriving by 6:30 PM", "₹1,240.00")
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR

# SMTP (password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="B2B Store <no-reply@example.com>"

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Comma-separated emails that are allowed to sign up/be promoted as admin via the seed script
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
